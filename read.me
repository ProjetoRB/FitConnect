create database if not exists fitconnect_db;

use fitconnect_db;

create table if not exists aluno (
    id bigint auto_increment primary key,
    nome_completo varchar(255) not null,
    email varchar(255) not null unique,
    cpf varchar(20) not null unique,
    peso varchar(20),
    altura varchar(20),
    sexo varchar(20),
    senha varchar(255) not null
);

create table if not exists agenda_aluno(
    id bigint auto_increment primary key,
    aluno_id bigint,
    data_agendamento date not null,
    hora_agendamento time not null,
    descricao varchar(100),
    status_agenda varchar(50) default 'pendente',
    
    foreign key (aluno_id)
        references aluno (id)
);

create table if not exists profissional (
    id bigint auto_increment primary key,
    nome_completo varchar(255) not null,
    email varchar(255) not null unique,
    cpf varchar(20) not null unique,
    area_profissional varchar(100) not null,
    documento_profissional varchar(100) not null,
    senha varchar(255) not null
);

drop table if exists agenda_profissional;

create table if not exists agenda_profissional (
    id bigint auto_increment primary key,
    profissional_id bigint not null,
    aluno_id bigint null,
    data_disponivel date not null,
    hora_disponivel time not null,
    descricao varchar(100),
    status_horario varchar(50) default 'disponivel',

    foreign key (profissional_id)
        references profissional(id),

    foreign key (aluno_id)
        references aluno(id)
);

create table if not exists chat_conversa (
    id bigint auto_increment primary key,
    aluno_id bigint not null,
    profissional_id bigint not null,
    data_criacao datetime default current_timestamp,
    status_conversa varchar(50) default 'ativa',

    foreign key (aluno_id)
        references aluno(id),
        
    foreign key (profissional_id)
        references profissional(id)
);

create table if not exists chat_mensagem (
    id bigint auto_increment primary key,
    conversa_id bigint not null,
    remetente_tipo varchar(20) not null,
    mensagem text not null,
    data_envio datetime default current_timestamp,
    lida boolean default false,

    foreign key (conversa_id)
        references chat_conversa(id)
);

