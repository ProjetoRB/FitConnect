-- =========================
-- SELECT TODOS OS ALUNOS
-- =========================

select * from aluno;


-- =========================
-- SELECT TODOS OS PROFISSIONAIS
-- =========================

select * from profissional;

-- =========================
-- SELECT AGENDA DOS PROFISSIONAIS
-- =========================

select
    agenda_profissional.id,
    profissional.nome_completo as profissional,
    profissional.area_profissional,
    agenda_profissional.data_disponivel,
    agenda_profissional.hora_disponivel,
    agenda_profissional.descricao,
    agenda_profissional.status_horario
from agenda_profissional
inner join profissional
    on agenda_profissional.profissional_id = profissional.id;

-- =========================
-- SELECT AGENDA DOS ALUNOS
-- =========================

select 
    agenda_aluno.id,
    aluno.nome_completo,
    agenda_aluno.data_agendamento,
    agenda_aluno.hora_agendamento,
    agenda_aluno.descricao,
    agenda_aluno.status_agenda
from agenda_aluno
inner join aluno
    on agenda_aluno.aluno_id = aluno.id;



-- =========================
-- SELECT CONVERSAS DO CHAT
-- =========================

select
    chat_conversa.id as conversa_id,
    aluno.nome_completo as aluno,
    profissional.nome_completo as profissional,
    chat_conversa.data_criacao,
    chat_conversa.status_conversa
from chat_conversa
inner join aluno
    on chat_conversa.aluno_id = aluno.id
inner join profissional
    on chat_conversa.profissional_id = profissional.id;


-- =========================
-- SELECT MENSAGENS DO CHAT
-- =========================

select
    chat_mensagem.id,
    chat_mensagem.conversa_id,
    chat_mensagem.remetente_tipo,
    chat_mensagem.mensagem,
    chat_mensagem.data_envio,
    chat_mensagem.lida
from chat_mensagem
order by chat_mensagem.data_envio asc;


-- =========================
-- SELECT MENSAGENS DE UMA CONVERSA ESPECÍFICA
-- =========================

select
    chat_mensagem.remetente_tipo,
    chat_mensagem.mensagem,
    chat_mensagem.data_envio
from chat_mensagem
where conversa_id = 1
order by data_envio asc;


-- =========================
-- SELECT PROFISSIONAIS POR ÁREA
-- =========================

select *
from profissional
where area_profissional = 'Nutricionista';


-- =========================
-- SELECT QUANTIDADE DE ALUNOS
-- =========================

select count(*) as total_alunos
from aluno;


-- =========================
-- SELECT QUANTIDADE DE PROFISSIONAIS
-- =========================

select count(*) as total_profissionais
from profissional;

-- =========================
-- SELECT APENAS OS HORÁRIOS DISPONÍVEIS
-- =========================

select
    agenda_profissional.id,
    profissional.nome_completo as profissional,
    profissional.area_profissional,
    agenda_profissional.data_disponivel,
    agenda_profissional.hora_disponivel,
    agenda_profissional.descricao,
    agenda_profissional.status_horario
from agenda_profissional
inner join profissional
    on agenda_profissional.profissional_id = profissional.id
where agenda_profissional.status_horario = 'disponivel';
